@@ -25,6 +26,34 @@ lazy_static! {
     };
 }
 
+#[cfg(not(feature = "solana-pedersen-bases"))]
+fn value_base() -> RistrettoPoint {
+    RistrettoPoint::hash_to_group_element(b"fastcrypto-blinding-gen-01")
+}
+
+#[cfg(not(feature = "solana-pedersen-bases"))]
+fn blinding_base() -> RistrettoPoint {
+    RistrettoPoint::generator()
+}
+
+/// Solana zk-sdk / Aptos: value base = Ristretto basepoint.
+#[cfg(feature = "solana-pedersen-bases")]
+fn value_base() -> RistrettoPoint {
+    RistrettoPoint::generator()
+}
+
+/// Solana zk-sdk / Aptos: blinding base = RistrettoPoint::hash_from_bytes::<Sha3_512>(basepoint),
+/// spelled via from_uniform_bytes because fastcrypto builds curve25519-dalek without `digest`.
+#[cfg(feature = "solana-pedersen-bases")]
+fn blinding_base() -> RistrettoPoint {
+    use sha3::{Digest, Sha3_512};
+    let mut wide = [0u8; 64];
+    wide.copy_from_slice(&Sha3_512::digest(
+        curve25519_dalek::constants::RISTRETTO_BASEPOINT_COMPRESSED.as_bytes(),
+    ));
+    RistrettoPoint(curve25519_dalek::ristretto::RistrettoPoint::from_uniform_bytes(&wide))
+}
+
 #[derive(Clone, Debug, PartialEq, Eq, Add, Sub, Mul, Serialize, Deserialize)]
 pub struct PedersenCommitment(pub RistrettoPoint);
 
